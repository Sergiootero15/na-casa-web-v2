</head>

<body>

    <!-- HEADER / MENÚ -->
    <header class="site-header">
        <div class="container header-content">
                  <a href="index.html" class="logo">
        <img src="img/NA CASA LOGO_LOGO POSITIVO.png" alt="NA CASA" class="logo-img">
      </a>

            <nav class="main-nav">
                <a href="index.html">Inicio</a>
